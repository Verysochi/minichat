{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "database-rules.json",
      "**/.*",
      "**/node_modules/**",
      "logs_*.zip"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      }
    ]
  },
  "database": {
    "rules": "database-rules.json"
  }
}