{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null && (root.child('approvals').child(auth.uid).exists() || auth.token.email == 'sochinewlife@gmail.com')",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('approvals').child(auth.uid).exists() || auth.token.email == 'sochinewlife@gmail.com')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.email == 'sochinewlife@gmail.com' || (auth.token.email != null && !data.child('firebaseUid').exists() && newData.child('firebaseUid').val() === auth.uid && data.child('login').val() != null && data.child('login').val() === auth.token.email))",
        "firebaseUid": {
          ".validate": "auth != null && newData.val() === auth.uid"
        },
        "isAdmin": {
          ".validate": "newData.val() !== true || auth.token.email == 'sochinewlife@gmail.com'"
        },
        "approved": {
          ".validate": "newData.val() !== true || auth.token.email == 'sochinewlife@gmail.com'"
        },
        "authEmail": {
          ".validate": "auth != null && newData.val() === auth.token.email"
        }
      },
      ".indexOn": "login"
    },
    "approvals": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.token.email == 'sochinewlife@gmail.com'"
      }
    },
    "userChats": {
      ".read": "auth != null && auth.token.email == 'sochinewlife@gmail.com'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child($uid).child('firebaseUid').val() === auth.uid)",
        ".write": "auth != null && root.child('approvals').child(auth.uid).exists()",
        "$chatId": {
          ".read": "auth != null && ($chatId === auth.uid + '_' + $uid || $chatId === $uid + '_' + auth.uid)"
        }
      }
    },
    "messages": {
      "$chatId": {
        ".read": "auth != null && root.child('approvals').child(auth.uid).exists()",
        ".write": "auth != null && root.child('approvals').child(auth.uid).exists()"
      },
      ".indexOn": "ts"
    },
    "groups": {
      ".read": "auth != null && root.child('approvals').child(auth.uid).exists()",
      "$gid": {
        ".write": "auth != null && (auth.token.email == 'sochinewlife@gmail.com' || newData.child('ownerId').val() === auth.uid || newData.child('admins').child(auth.uid).exists() || root.child('groups').child($gid).child('ownerId').val() === auth.uid || root.child('groups').child($gid).child('admins').child(auth.uid).exists())",
        "members": {
          "$me": {
            ".write": "auth != null && auth.uid === $me && root.child('groupInvites').child($me).child($gid).exists()"
          }
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child($uid).child('firebaseUid').val() === auth.uid || data.child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child($uid).child('firebaseUid').val() === auth.uid || data.child(auth.uid).exists() || newData.child(auth.uid).exists())"
      }
    },
    "friendRequests": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child($uid).child('firebaseUid').val() === auth.uid)",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child($uid).child('firebaseUid').val() === auth.uid || data.child(auth.uid).exists() || newData.child(auth.uid).exists())"
      }
    },
    "rels": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child($uid).child('firebaseUid').val() === auth.uid || data.child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child($uid).child('firebaseUid').val() === auth.uid || data.child(auth.uid).exists() || newData.child(auth.uid).exists())",
        "$other": {
          ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 40)"
        }
      }
    },
    "relReqs": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child($uid).child('firebaseUid').val() === auth.uid)",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child($uid).child('firebaseUid').val() === auth.uid || data.child(auth.uid).exists() || newData.child(auth.uid).exists())",
        "$from": {
          ".validate": "newData.val() === null || (newData.hasChild('rel') && newData.child('rel').isString() && newData.child('rel').val().length <= 40 && newData.hasChild('ts') && newData.child('ts').isNumber())"
        }
      },
      ".indexOn": "ts"
    },
        "$from": {
          ".validate": "newData.val() === null || (newData.hasChild('rel') && newData.child('rel').isString() && newData.child('rel').val().length <= 40 && newData.hasChild('ts') && newData.child('ts').isNumber())"
        }
      }
    },
    "news": {
      ".read": "auth != null && root.child('approvals').child(auth.uid).exists()",
      ".write": "auth != null && auth.token.email == 'sochinewlife@gmail.com'",
      "$newsId": {
        "comments": {
          ".write": "auth != null && root.child('approvals').child(auth.uid).exists()"
        },
        "reactions": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('approvals').child(auth.uid).exists()",
            ".validate": "newData.val() === '🤘'"
          }
        }
      }
    },
    "newsProposals": {
      ".read": "auth != null && (data.child(auth.uid).exists() || auth.token.email == 'sochinewlife@gmail.com')",
      ".write": "auth != null && (auth.token.email == 'sochinewlife@gmail.com' || root.child('approvals').child(auth.uid).exists())"
    },
    "userPosts": {
      ".read": "auth != null && root.child('approvals').child(auth.uid).exists()",
      ".write": "auth != null && root.child('approvals').child(auth.uid).exists()"
    },
    "files": {
      "$key": {
        ".read": "auth != null && root.child('approvals').child(auth.uid).exists()",
        ".write": "auth != null && root.child('approvals').child(auth.uid).exists()"
      }
    },
    "notifs": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child($uid).child('firebaseUid').val() === auth.uid)",
        ".write": "auth != null && (auth.uid === $uid || root.child('approvals').child(auth.uid).exists())"
      }
    },
    "blocks": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child($uid).child('firebaseUid').val() === auth.uid)",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child($uid).child('firebaseUid').val() === auth.uid)",
        "$me": {
          ".read": "auth != null && auth.uid === $me"
        }
      }
    },
    "typing": {
      "$chatId": {
        ".read": "auth != null && root.child('approvals').child(auth.uid).exists()",
        ".write": "auth != null && root.child('approvals').child(auth.uid).exists()"
      }
    },
    "groupInvites": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child($uid).child('firebaseUid').val() === auth.uid)",
        ".write": "auth != null && root.child('approvals').child(auth.uid).exists()"
      }
    },
    "groupJoinRequests": {
      "$gid": {
        ".read": "auth != null && (root.child('groups').child($gid).child('members').child(auth.uid).exists() || auth.token.email == 'sochinewlife@gmail.com')",
        "$uid": {
          ".write": "auth != null && ((auth.uid === $uid && root.child('groups').child($gid).exists() && root.child('groups').child($gid).child('members').child(auth.uid).exists() === false) || root.child('groups').child($gid).child('admins').child(auth.uid).exists() || root.child('groups').child($gid).child('ownerId').val() === auth.uid || auth.token.email == 'sochinewlife@gmail.com')",
          ".validate": "newData.child('name').isString() && newData.child('ts').isNumber()"
        }
      },
      ".indexOn": "ts"
    },
    "calls": {
      ".read": "auth != null && root.child('approvals').child(auth.uid).exists()",
      "$callId": {
        ".write": "auth != null && root.child('approvals').child(auth.uid).exists()"
      },
      ".indexOn": "to"
    },
    "invites": {
      ".read": "auth != null && auth.token.email == 'sochinewlife@gmail.com'",
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email == 'sochinewlife@gmail.com'",
        "used": {
          ".write": "auth != null && root.child('invites').child($code).exists() && root.child('invites').child($code).child('used').val() !== true"
        },
        "usedBy": {
          ".write": "auth != null",
          ".validate": "newData.val() === auth.uid"
        },
        "usedAt": {
          ".write": "auth != null"
        }
      }
    },
    "pendingRegistrations": {
      ".read": "auth != null && auth.token.email == 'sochinewlife@gmail.com'",
      ".write": "auth != null && auth.token.email == 'sochinewlife@gmail.com'",
      "$reqId": {
        ".write": "auth != null && (!data.exists() || auth.token.email == 'sochinewlife@gmail.com')",
        "login": {
          ".validate": "newData.isString() && newData.val().length < 120"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        }
      },
      ".indexOn": "ts"
    },
    "passResets": {
      ".read": "auth != null && auth.token.email == 'sochinewlife@gmail.com'",
      ".write": "auth != null && auth.token.email == 'sochinewlife@gmail.com'"
    },
    "loginBlocks": {
      ".read": "auth != null && auth.token.email == 'sochinewlife@gmail.com'",
      ".write": "auth != null && auth.token.email == 'sochinewlife@gmail.com'"
    },
    "loginAttempts": {
      ".read": "auth != null && auth.token.email == 'sochinewlife@gmail.com'",
      ".write": "auth != null && auth.token.email == 'sochinewlife@gmail.com'"
    },
    "sessionLogs": {
      ".read": "auth != null && auth.token.email == 'sochinewlife@gmail.com'",
      ".write": "auth != null && auth.token.email == 'sochinewlife@gmail.com'",
      "$logId": {
        ".write": "auth != null && !data.exists() && newData.child('uid').val() != null",
        "uid": {
          ".validate": "auth != null && (newData.val() === auth.uid || auth.token.email == 'sochinewlife@gmail.com')"
        }
      },
      ".indexOn": "uid"
    },
    "deleteLogs": {
      ".read": "auth != null && auth.token.email == 'sochinewlife@gmail.com'",
      ".write": "auth != null && root.child('approvals').child(auth.uid).exists()"
    }
  }
}
